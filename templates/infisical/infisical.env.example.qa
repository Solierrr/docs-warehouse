# =============================================================================
# Infisical — ambiente: qa (Render)
# =============================================================================
# Catálogo completo de todas as secrets/config do projeto, organizado pelas
# mesmas pastas usadas no Infisical. Todos os valores estão vazios de
# propósito — isso NÃO é um .env de verdade, é o template mestre pra
# conferir o que existe e popular o Infisical (via dashboard, CLI ou import).
#
# Ver design completo em:
# docs-warehouse/architecture/2026-09-03-secrets-and-envs-design.md
#
# Nem todo repo consome todas as chaves de uma pasta — cada .env.example de
# repo documenta o subconjunto que aquele serviço específico usa.
# =============================================================================

# ---------------------------------------------------------------------------
# /database
# Postgres (mesma instância/credenciais, banco muda por consumidor),
# Mongo (idem) e Neo4j (único consumidor: api-recommendation).
# ---------------------------------------------------------------------------
DB_POSTGRES_URI=
DB_POSTGRES_HOST=
DB_POSTGRES_PORT=
DB_POSTGRES_USER=
DB_POSTGRES_PASSWORD=
DB_POSTGRES_SSLMODE=
DB_POSTGRES_CORE=
DB_POSTGRES_AUTH=
DB_POSTGRES_BUSINESS=

DB_MONGO_URI=
DB_MONGO_MESSENGER=
DB_MONGO_AGENTS=

DB_NEO4J_URI=
DB_NEO4J_USER=
DB_NEO4J_PASSWORD=
DB_NEO4J_DATABASE=

# ---------------------------------------------------------------------------
# /redis
# Instâncias Upstash separadas por consumidor (mesmo padrão host/port/user/pass).
# ---------------------------------------------------------------------------
UPSTASH_AGENTS_HOST=
UPSTASH_AGENTS_PORT=
UPSTASH_AGENTS_USERNAME=
UPSTASH_AGENTS_PASSWORD=

UPSTASH_CORE_HOST=
UPSTASH_CORE_PORT=
UPSTASH_CORE_USERNAME=
UPSTASH_CORE_PASSWORD=

# ---------------------------------------------------------------------------
# /cloudinary
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=

# ---------------------------------------------------------------------------
# /google
# ---------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_API_KEY=

# ---------------------------------------------------------------------------
# /llm
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY2=
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
LLM_MODEL=
LLM_TEMPERATURE=

# ---------------------------------------------------------------------------
# /auth
# Emitido pelo api-auth; SERVICE_JWT_SECRET/SERVICE_CLIENT_SECRET são
# compartilhados com quem valida token de serviço M2M.
# ---------------------------------------------------------------------------
JWT_ISSUER=
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=
JWT_KEYSTORE_PATH=
JWT_KEYSTORE_PASSWORD=
JWT_ACTIVE_KID=
JWT_KEYSTORE_BASE64=
FIREBASE_ENABLED=
FIREBASE_PROJECT_ID=
SERVICE_JWT_SECRET=
SERVICE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# /otel
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_VERSION=
DEPLOYMENT_ENVIRONMENT=
OTEL_TRACES_SAMPLING_PROBABILITY=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=
TAIL_SAMPLING_BASELINE_PCT=

# ---------------------------------------------------------------------------
# /databricks
# ---------------------------------------------------------------------------
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA_CORE=
DATABRICKS_SCHEMA_AUTH=

# ---------------------------------------------------------------------------
# /vite
# ---------------------------------------------------------------------------
VITE_APP_MODE=
VITE_MOCKS=
VITE_LOGS=
VITE_EXCHANGE_API=

# ---------------------------------------------------------------------------
# /service-urls
# Endereço de outro serviço interno — valor MUDA por ambiente (local =
# localhost:porta, prod = DNS interno do cluster, qa = URL pública do Render).
# ---------------------------------------------------------------------------
PERSISTENCE_BASE_URL=
JWT_JWK_SET_URI=
API_MESSENGER_URL=
MCP_URL=
VITE_API_PERSISTENCE=

# ---------------------------------------------------------------------------
# /mcp
# Chave própria do serviço (não é credencial de tecnologia compartilhada).
# ---------------------------------------------------------------------------
MCP_API_KEY=
PORT=

# ---------------------------------------------------------------------------
# /recommendation
# Config de negócio + chaves de API próprias do serviço.
# ---------------------------------------------------------------------------
APP_ENVIRONMENT=
APP_TIMEZONE=
DOCS_ENABLED=
API_KEY=
SYNC_API_KEY=
RECOMMENDATION_API_KEY=
SYNC_ON_STARTUP=
SYNC_BATCH_SIZE=
SYNC_LOCK_LEASE_SECONDS=
SYNC_MIN_DOMAIN_RETENTION_RATIO=
SNAPSHOT_MAX_AGE_SECONDS=
RECOMMENDATION_RESULT_LIMIT=
RECOMMENDATION_POOL_LIMIT=

# ---------------------------------------------------------------------------
# /agent-queue
# Config de negócio da fila de agentes (Redis Streams), não é credencial.
# ---------------------------------------------------------------------------
AGENT_STREAM_CHATBOT=
AGENT_STREAM_MAXLEN=
AGENT_STREAM_GROUP=
AGENT_CONSUMER_PREFIX=
AGENT_CONSUMER_BLOCK_MS=
AGENT_CONSUMER_BATCH_SIZE=
AGENT_CONSUMER_CLAIM_IDLE_MS=
AGENT_CONSUMER_CLAIM_INTERVAL_MS=
AGENT_CONSUMER_COUNT=
AGENT_CONSUMER_MAX_ATTEMPTS=
AGENT_CONSUMER_IDLE_DELAY_MS=
AGENT_CONSUMER_RETRY_DELAY_MS=
AGENT_RESULT_PREFIX=
AGENT_RESULT_TTL_SECONDS=

# ---------------------------------------------------------------------------
# /outbox
# Config de negócio da fila de outbox (Redis Streams), não é credencial.
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_STREAM_KEY=
OUTBOX_CONSUMER_GROUP=
OUTBOX_DLQ_STREAM_KEY=
OUTBOX_MAX_DELIVERY_ATTEMPTS=
OUTBOX_VISIBILITY_TIMEOUT_MS=
OUTBOX_RECLAIM_INTERVAL_MS=
OUTBOX_CONSUMER_ENABLED=

# ---------------------------------------------------------------------------
# /shared
# Cross-cutting, não amarrado a nenhum serviço específico.
# ---------------------------------------------------------------------------
DOCKERHUB_TOKEN=
