{
  "name": "Code Quality Copilot",
  "target": "branch",
  "source_type": "Repository",
  "source": "Solierrr",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": true
      }
    }
  ],
  "bypass_actors": []
}
